import 'package:flutter/material.dart';
import 'package:installed_apps/installed_apps.dart';
import 'history_manager.dart';

class AppSecurityPage extends StatefulWidget {
  const AppSecurityPage({super.key});

  @override
  State<AppSecurityPage> createState() => _AppSecurityPageState();
}

class _AppSecurityPageState extends State<AppSecurityPage> {
  List<dynamic> apps = [];
  bool loading = true;

  @override
  void initState() {
    super.initState();
    loadApps();
  }

  Future<void> loadApps() async {
    try {
      final installedApps = await InstalledApps.getInstalledApps();

      if (!mounted) return;

      setState(() {
        apps = installedApps;
        loading = false;
      });

      HistoryManager.addRecord(
        title: 'Application Security',
        result: '${installedApps.length} applications scanned',
        secure: true,
      );
    } catch (e) {
      if (!mounted) return;

      setState(() {
        loading = false;
      });

      HistoryManager.addRecord(
        title: 'Application Security',
        result: 'Unable to scan installed applications',
        secure: false,
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('App Security'),
        backgroundColor: const Color(0xFF11182D),
      ),
      body: loading
          ? const Center(
              child: CircularProgressIndicator(),
            )
          : apps.isEmpty
              ? const Center(
                  child: Text(
                    'No applications found',
                    style: TextStyle(fontSize: 18),
                  ),
                )
              : Column(
                  children: [
                    Container(
                      width: double.infinity,
                      margin: const EdgeInsets.all(16),
                      padding: const EdgeInsets.all(18),
                      decoration: BoxDecoration(
                        color: const Color(0xFF151F38),
                        borderRadius: BorderRadius.circular(16),
                      ),
                      child: Row(
                        children: [
                          const Icon(
                            Icons.apps,
                            color: Colors.cyan,
                            size: 35,
                          ),
                          const SizedBox(width: 15),
                          Column(
                            crossAxisAlignment:
                                CrossAxisAlignment.start,
                            children: [
                              const Text(
                                'Installed Applications',
                                style: TextStyle(
                                  fontWeight: FontWeight.bold,
                                  fontSize: 17,
                                ),
                              ),
                              const SizedBox(height: 5),
                              Text(
                                '${apps.length} applications detected',
                                style: TextStyle(
                                  color: Colors.grey.shade400,
                                ),
                              ),
                            ],
                          ),
                        ],
                      ),
                    ),
                    Expanded(
                      child: ListView.builder(
                        itemCount: apps.length,
                        itemBuilder: (context, index) {
                          final app = apps[index];

                          return Card(
                            margin: const EdgeInsets.symmetric(
                              horizontal: 16,
                              vertical: 5,
                            ),
                            color: const Color(0xFF151F38),
                            child: ListTile(
                              leading: const CircleAvatar(
                                backgroundColor:
                                    Color(0xFF24304D),
                                child: Icon(
                                  Icons.android,
                                  color: Colors.greenAccent,
                                ),
                              ),
                              title: Text(
                                app.name ?? 'Unknown App',
                                style: const TextStyle(
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                              subtitle: Text(
                                app.packageName ??
                                    'Unknown package',
                              ),
                            ),
                          );
                        },
                      ),
                    ),
                  ],
                ),
    );
  }
}
