import 'package:flutter/material.dart';
import 'history_manager.dart';

class PasswordSecurityPage extends StatefulWidget {
  const PasswordSecurityPage({super.key});

  @override
  State<PasswordSecurityPage> createState() => _PasswordSecurityPageState();
}

class _PasswordSecurityPageState extends State<PasswordSecurityPage> {
  final TextEditingController passwordController =
      TextEditingController();

  String strength = 'Enter a password';
  Color strengthColor = Colors.grey;
  double strengthValue = 0;

  bool hasLength = false;
  bool hasUppercase = false;
  bool hasLowercase = false;
  bool hasNumber = false;
  bool hasSpecial = false;

  void checkPassword(String password) {
    setState(() {
      hasLength = password.length >= 8;
      hasUppercase = RegExp(r'[A-Z]').hasMatch(password);
      hasLowercase = RegExp(r'[a-z]').hasMatch(password);
      hasNumber = RegExp(r'[0-9]').hasMatch(password);
      hasSpecial =
          RegExp(r'[!@#$%^&*(),.?":{}|<>_\-]').hasMatch(password);

      int score = 0;

      if (hasLength) score++;
      if (hasUppercase) score++;
      if (hasLowercase) score++;
      if (hasNumber) score++;
      if (hasSpecial) score++;

      if (password.isEmpty) {
        strength = 'Enter a password';
        strengthColor = Colors.grey;
        strengthValue = 0;
      } else if (score <= 2) {
        strength = 'Weak';
        strengthColor = Colors.redAccent;
        strengthValue = 0.3;
      } else if (score == 3 || score == 4) {
        strength = 'Medium';
        strengthColor = Colors.orangeAccent;
        strengthValue = 0.6;
      } else {
        strength = 'Strong';
        strengthColor = Colors.greenAccent;
        strengthValue = 1.0;
      }
    });
  }

  bool isPasswordSecure() {
    return hasLength &&
        hasUppercase &&
        hasLowercase &&
        hasNumber &&
        hasSpecial;
  }

  Widget requirementRow(String text, bool satisfied) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        children: [
          Icon(
            satisfied ? Icons.check_circle : Icons.cancel,
            color: satisfied
                ? Colors.greenAccent
                : Colors.redAccent,
            size: 20,
          ),
          const SizedBox(width: 10),
          Text(text),
        ],
      ),
    );
  }

  void finishPasswordCheck() {
    final secure = isPasswordSecure();

    HistoryManager.addRecord(
      title: 'Password Security',
      result: secure
          ? 'Strong password verified'
          : 'Password does not meet all requirements',
      secure: secure,
    );

    Navigator.pop(
      context,
      secure,
    );
  }

  @override
  void dispose() {
    passwordController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Password Security'),
        backgroundColor: const Color(0xFF11182D),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Password Strength Checker',
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            Text(
              'Check the strength of your password',
              style: TextStyle(
                color: Colors.grey.shade400,
              ),
            ),

            const SizedBox(height: 25),

            TextField(
              controller: passwordController,
              obscureText: true,
              onChanged: checkPassword,
              decoration: InputDecoration(
                labelText: 'Enter Password',
                hintText: 'Type your password',
                prefixIcon: const Icon(Icons.lock),
                suffixIcon: Icon(
                  Icons.security,
                  color: strengthColor,
                ),
                filled: true,
                fillColor: const Color(0xFF151F38),
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
              ),
            ),

            const SizedBox(height: 25),

            Card(
              color: const Color(0xFF151F38),
              child: Padding(
                padding: const EdgeInsets.all(18),
                child: Column(
                  children: [
                    const Text(
                      'PASSWORD STRENGTH',
                      style: TextStyle(
                        fontSize: 13,
                        color: Colors.grey,
                        letterSpacing: 1.5,
                      ),
                    ),

                    const SizedBox(height: 12),

                    Text(
                      strength,
                      style: TextStyle(
                        fontSize: 26,
                        fontWeight: FontWeight.bold,
                        color: strengthColor,
                      ),
                    ),

                    const SizedBox(height: 15),

                    LinearProgressIndicator(
                      value: strengthValue,
                      minHeight: 8,
                      borderRadius: BorderRadius.circular(10),
                      backgroundColor: Colors.grey.shade800,
                      valueColor:
                          AlwaysStoppedAnimation<Color>(
                        strengthColor,
                      ),
                    ),
                  ],
                ),
              ),
            ),

            const SizedBox(height: 20),

            const Text(
              'Security Requirements',
              style: TextStyle(
                fontSize: 19,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 10),

            Card(
              color: const Color(0xFF151F38),
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  children: [
                    requirementRow(
                      'At least 8 characters',
                      hasLength,
                    ),
                    requirementRow(
                      'Uppercase letter (A-Z)',
                      hasUppercase,
                    ),
                    requirementRow(
                      'Lowercase letter (a-z)',
                      hasLowercase,
                    ),
                    requirementRow(
                      'Number (0-9)',
                      hasNumber,
                    ),
                    requirementRow(
                      'Special character',
                      hasSpecial,
                    ),
                  ],
                ),
              ),
            ),

            const SizedBox(height: 25),

            SizedBox(
              width: double.infinity,
              height: 50,
              child: ElevatedButton.icon(
                onPressed: finishPasswordCheck,
                icon: const Icon(Icons.check),
                label: const Text(
                  'COMPLETE PASSWORD CHECK',
                ),
              ),
            ),

            const SizedBox(height: 15),

            Container(
              padding: const EdgeInsets.all(15),
              decoration: BoxDecoration(
                color: const Color(0xFF151F38),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: Colors.cyan.withOpacity(0.25),
                ),
              ),
              child: const Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Icon(
                    Icons.info_outline,
                    color: Colors.cyan,
                  ),
                  SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      'Your password is checked locally on the device '
                      'and is not sent to a server.',
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
