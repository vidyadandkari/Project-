import 'package:flutter/material.dart';

class SecurityAssessmentPage extends StatelessWidget {
  final bool networkChecked;
  final bool appScanCompleted;
  final bool threatScanCompleted;
  final bool passwordSecure;
  final bool deviceChecked;

  const SecurityAssessmentPage({
    super.key,
    required this.networkChecked,
    required this.appScanCompleted,
    required this.threatScanCompleted,
    required this.passwordSecure,
    required this.deviceChecked,
  });

  int get securityScore {
    int score = 10;

    if (networkChecked) {
      score += 18;
    }

    if (appScanCompleted) {
      score += 18;
    }

    if (threatScanCompleted) {
      score += 24;
    }

    if (passwordSecure) {
      score += 20;
    }

    if (deviceChecked) {
      score += 10;
    }

    return score;
  }

  String get securityLevel {
    if (securityScore >= 80) {
      return 'Good Security Level';
    } else if (securityScore >= 60) {
      return 'Moderate Security Level';
    } else {
      return 'Needs Attention';
    }
  }

  Color get scoreColor {
    if (securityScore >= 80) {
      return Colors.greenAccent;
    } else if (securityScore >= 60) {
      return Colors.orangeAccent;
    } else {
      return Colors.redAccent;
    }
  }

  @override
  Widget build(BuildContext context) {
    final color = scoreColor;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Security Assessment'),
        backgroundColor: const Color(0xFF11182D),
      ),

      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),

        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Security Assessment',
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            Text(
              'Current status of SentinelX security checks',
              style: TextStyle(
                color: Colors.grey.shade400,
                fontSize: 15,
              ),
            ),

            const SizedBox(height: 25),

            // SECURITY SCORE
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(25),

              decoration: BoxDecoration(
                color: const Color(0xFF151F38),
                borderRadius: BorderRadius.circular(18),
                border: Border.all(
                  color: color.withOpacity(0.3),
                ),
              ),

              child: Column(
                children: [
                  Icon(
                    Icons.shield,
                    size: 65,
                    color: color,
                  ),

                  const SizedBox(height: 12),

                  const Text(
                    'OVERALL SECURITY SCORE',
                    style: TextStyle(
                      color: Colors.grey,
                      fontSize: 13,
                      letterSpacing: 1.5,
                    ),
                  ),

                  const SizedBox(height: 10),

                  Text(
                    '$securityScore / 100',
                    style: TextStyle(
                      color: color,
                      fontSize: 38,
                      fontWeight: FontWeight.bold,
                    ),
                  ),

                  const SizedBox(height: 8),

                  Text(
                    securityLevel,
                    style: const TextStyle(
                      fontSize: 16,
                    ),
                  ),

                  const SizedBox(height: 15),

                  LinearProgressIndicator(
                    value: securityScore / 100,
                    minHeight: 9,
                    borderRadius: BorderRadius.circular(10),
                    backgroundColor: Colors.grey.shade800,
                    valueColor:
                        AlwaysStoppedAnimation<Color>(color),
                  ),
                ],
              ),
            ),

            const SizedBox(height: 25),

            const Text(
              'Security Checks',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 15),

            _statusCard(
              icon: Icons.wifi,
              title: 'Network Security',
              completed: networkChecked,
              result: networkChecked
                  ? 'Network check completed'
                  : 'Network check not completed',
            ),

            _statusCard(
              icon: Icons.apps,
              title: 'Application Security',
              completed: appScanCompleted,
              result: appScanCompleted
                  ? 'Application scan completed'
                  : 'Application scan not completed',
            ),

            _statusCard(
              icon: Icons.warning_amber_rounded,
              title: 'Threat Detection',
              completed: threatScanCompleted,
              result: threatScanCompleted
                  ? 'Threat scan completed'
                  : 'Threat scan not completed',
            ),

            _statusCard(
              icon: Icons.lock,
              title: 'Password Security',
              completed: passwordSecure,
              result: passwordSecure
                  ? 'Strong password verified'
                  : 'Strong password not verified',
            ),

            _statusCard(
              icon: Icons.phone_android,
              title: 'Device Security',
              completed: deviceChecked,
              result: deviceChecked
                  ? 'Device information checked'
                  : 'Device check not completed',
            ),

            const SizedBox(height: 25),

            const Text(
              'Recommendations',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 15),

            _buildRecommendations(),

            const SizedBox(height: 20),

            Container(
              padding: const EdgeInsets.all(15),

              decoration: BoxDecoration(
                color: const Color(0xFF151F38),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: Colors.cyan.withOpacity(0.25),
                ),
              ),

              child: const Row(
                crossAxisAlignment:
                    CrossAxisAlignment.start,

                children: [
                  Icon(
                    Icons.info_outline,
                    color: Colors.cyan,
                  ),

                  SizedBox(width: 10),

                  Expanded(
                    child: Text(
                      'The score represents completion of '
                      'SentinelX security checks. It is not a '
                      'guarantee that the device is completely secure.',
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _statusCard({
    required IconData icon,
    required String title,
    required bool completed,
    required String result,
  }) {
    final color =
        completed ? Colors.greenAccent : Colors.orangeAccent;

    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      color: const Color(0xFF151F38),

      child: ListTile(
        contentPadding: const EdgeInsets.all(15),

        leading: CircleAvatar(
          backgroundColor: color.withOpacity(0.15),

          child: Icon(
            icon,
            color: color,
          ),
        ),

        title: Text(
          title,
          style: const TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),

        subtitle: Padding(
          padding: const EdgeInsets.only(top: 5),
          child: Text(result),
        ),

        trailing: Icon(
          completed
              ? Icons.check_circle
              : Icons.pending_actions,
          color: color,
        ),
      ),
    );
  }

  Widget _buildRecommendations() {
    final List<String> recommendations = [];

    if (!networkChecked) {
      recommendations.add(
        'Perform a Network Security check.',
      );
    }

    if (!appScanCompleted) {
      recommendations.add(
        'Review your installed applications.',
      );
    }

    if (!threatScanCompleted) {
      recommendations.add(
        'Run the Threat Detection scan.',
      );
    }

    if (!passwordSecure) {
      recommendations.add(
        'Verify a strong password using Password Security.',
      );
    }

    if (!deviceChecked) {
      recommendations.add(
        'Complete the Device Security check.',
      );
    }

    if (recommendations.isEmpty) {
      recommendations.add(
        'All SentinelX security checks have been completed.',
      );
      recommendations.add(
        'Continue keeping your device and applications updated.',
      );
    }

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),

      decoration: BoxDecoration(
        color: const Color(0xFF151F38),
        borderRadius: BorderRadius.circular(14),
      ),

      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,

        children: recommendations.map(
          (recommendation) {
            return Padding(
              padding: const EdgeInsets.symmetric(
                vertical: 6,
              ),

              child: Row(
                crossAxisAlignment:
                    CrossAxisAlignment.start,

                children: [
                  const Icon(
                    Icons.lightbulb_outline,
                    color: Colors.cyan,
                    size: 20,
                  ),

                  const SizedBox(width: 10),

                  Expanded(
                    child: Text(
                      recommendation,
                    ),
                  ),
                ],
              ),
            );
          },
        ).toList(),
      ),
    );
  }
}
